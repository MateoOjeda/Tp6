# Leave STRAPI_URL empty to render content/default-content.json without a CMS.
STRAPI_URL=http://localhost:1337

# Optional: Strapi read-only API token (Settings → API Tokens). Not needed while the Public role can read.
STRAPI_API_TOKEN=

# Fallback time-based revalidation; the webhook below makes publishes show up immediately.
STRAPI_REVALIDATE_SECONDS=3600

# Shared secret for the Strapi webhook → POST /api/revalidate (header: Authorization: Bearer <secret>)
STRAPI_WEBHOOK_SECRET=
