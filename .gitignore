# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any package manager, any folder)
node_modules/
.pnpm-store/

# next.js
.next/
out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and secrets — keep only committed examples
.env*
!.env.example
!.env*.example
*.pem
*.p12
*.key
id_rsa
id_rsa.pub
credentials.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS / editor / local agent caches
.DS_Store
.atl/

# Strapi runtime (defense in depth; cms/.gitignore also covers these)
cms/.tmp/
cms/.cache/
cms/dist/
cms/.strapi/
cms/*.db
*.db